# MPL Interpreter - Server Environment Configuration

# ---------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------
# Connection string for Prisma ORM (e.g. postgresql://user:password@localhost:5432/mpl?schema=public)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mpl_db?schema=public"

# ---------------------------------------------------------
# Caching & Optimization (Redis)
# ---------------------------------------------------------
# Redis is used for rate-limiting execution requests and caching compilation results
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------
# Authentication (JWT & OAuth)
# ---------------------------------------------------------
# 64+ byte secure random string for signing JWT tokens
JWT_SECRET="generate_a_secure_random_string_here_for_production"
JWT_EXPIRES_IN="7d"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------
# External Services
# ---------------------------------------------------------
# Resend API key for transactional emails (password recovery, welcome emails)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="noreply@mpl.saymed.net"
MPL_BIN_PATH=/app/build/mpl
