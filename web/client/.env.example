# MPL Interpreter - Client Environment Configuration

# ---------------------------------------------------------
# API & WebSocket Connections
# ---------------------------------------------------------
# In production, these should generally be relative paths (e.g., /api and /)
# to leverage the same-origin policy and prevent Private Network Access (PNA) 
# security prompts in modern browsers. Vite proxies these in development.
VITE_API_URL=/api
VITE_SOCKET_URL=/

# ---------------------------------------------------------
# Feature Flags & Config
# ---------------------------------------------------------
VITE_ENABLE_AUTH=true
VITE_APP_TITLE=MPL Interpreter
